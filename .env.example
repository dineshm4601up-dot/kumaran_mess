# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.

# --- Supabase ---------------------------------------------------------
# Project URL and anon key: safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: server-only. Never prefix with NEXT_PUBLIC_, never
# import it into client components, never log it.
SUPABASE_SERVICE_ROLE_KEY=

# --- OTP / SMS provider (mobile verification) --------------------------
# This project generates and verifies its own OTP codes (see
# supabase/migrations/20260101000013_phone_auth.sql) — these variables
# only control how the plain SMS text gets sent. SMS_PROVIDER selects the
# adapter in src/lib/sms/send-sms.ts: "console" (default, logs the code
# instead of sending — safe for local dev, never pretends to send a real
# SMS) or "twilio" (plain Twilio Programmable Messaging, not Twilio
# Verify, since Verify wants to own the OTP lifecycle itself).
SMS_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Geocoding / maps ---------------------------------------------------
# Address search on the checkout map (src/lib/geocoding/geocode.ts).
# GEOCODING_PROVIDER: "nominatim" (default, no key needed — the free
# public OpenStreetMap instance, NOT suitable for production volume: max
# 1 request/sec, no heavy/automated use, see
# https://operations.osmfoundation.org/policies/nominatim/) or
# "locationiq" (needs LOCATIONIQ_API_KEY — check locationiq.com's current
# pricing/limits before relying on it for production).
GEOCODING_PROVIDER=nominatim
LOCATIONIQ_API_KEY=

# --- App -----------------------------------------------------------------
# Public base URL of the deployed site, used for links and redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
